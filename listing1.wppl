// Minds Like Ours (Brooke-Wilson & Tenenbaum), Listing 1
// The spectator's model of a single throw.
// Run by pasting into the editor at https://webppl.org

var g = 9.8;          // acceleration due to gravity (m/s^2)
var center = 34.75;   // distance to the center target on the ice (m)

// travelDist returns the distribution object so it can be observed
var travelDist = function(push, mu, sweep) {
  var mu_eff = sweep ? 0.9 * mu : mu;                 // sweeping lowers friction
  var distance = (push * push) / (2 * g * mu_eff);    // stopping distance of a sliding stone
  return Gaussian({mu: distance, sigma: 0.5});        // small unevenness in the ice
};

var travel = function(push, mu, sweep) {
  return sample(travelDist(push, mu, sweep));
};

var Ks = mapN(function(i) { return 0.7 + 0.005 * i; }, 81);   // candidate values of an adjustment factor K

var listing1 = Infer({method: 'rejection', samples: 1000, incremental: true}, function() {
  var mu = gaussian(0.015, 0.001);          // friction of the ice (default value)
  var push_base = gaussian(3.2, 0.05);      // push speed needed to reach the center ring
                                            // under typical ice friction conditions

  var push1 = gaussian(push_base, 0.3);     // throws may vary in pushing speed

  observe(travelDist(push1, mu, false), 42);

  var on_center = function(K) { return Math.abs(travel(K * push_base, mu, false) - center) < 1; };
  var swept_travel = travel(push1, mu, true);

  return {
    ratio: push1 / push_base,
    friction: mu,
    swept: swept_travel,
    on_center: map(on_center, Ks)};
});

var ratioDist = marginalize(listing1, 'ratio');
print("Inferred ratio of first push speed to usual speed: " + expectation(ratioDist));
viz(ratioDist);

var frictionDist = marginalize(listing1, 'friction');
print("Inferred friction coefficient: " + expectation(frictionDist));
viz(frictionDist);

var sweptDist = marginalize(listing1, 'swept');
print("Counterfactual distance if the stone had been swept: " + expectation(sweptDist));
viz(sweptDist);

// choose K to maximize P(on_center(K))
var P = mapIndexed(function(i, K) {
  return expectation(listing1, function(s) { return s.on_center[i] ? 1 : 0; });
}, Ks);
var best_K = Ks[_.indexOf(P, _.max(P))];

// Print the best value of K
print("Best value of K: " + best_K);

// Visualize the probability of a successful push as a function of K
viz.line(Ks, P, {
  options: {
    title: "Probability of Successful Push vs. K",
    xLabel: "Adjustment Factor K",
    yLabel: "Probability of Stopping within 1m of Center"
  }
});
